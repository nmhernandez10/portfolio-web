---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  Avatar,
  Button,
  Card,
  Icon,
  IconButton,
  Input,
  ProjectBrief,
  ProjectCard,
  SectionHeader,
  SegmentedToggle,
  Select,
  SkillGroup,
  StatBlock,
  Switch,
  Tag,
  Textarea,
  TextLink,
  TimelineItem,
  WorkRow,
} from "@/ui";
import { SiteThemeToggle } from "@/sections/SiteThemeToggle";

const buttonVariants = ["primary", "secondary", "ghost"] as const;
const buttonSizes = ["sm", "md", "lg"] as const;
const tagTones = [
  "neutral",
  "accent",
  "outline",
  "success",
  "info",
  "danger",
] as const;
const cardTones = ["raised", "sunken", "accent", "inverse", "bare"] as const;
const cardPaddings = ["none", "sm", "md", "lg"] as const;
const iconButtonVariants = ["outline", "quiet", "filled"] as const;
const iconButtonSizes = ["sm", "md", "lg"] as const;
const uiGlyphs = ["arrow-up-right", "download", "mail", "terminal", "check"];
const techMarks = ["postgresql", "react", "typescript", "docker", "nestjs"];
---

<BaseLayout
  title="UI kit — nicolasmateo.dev"
  description="Every component in the design system, in every variant its props allow."
>
  <div class="kit">
    <header class="kit-head">
      <div class="kit-head-row">
        <h1>UI kit</h1>
        <SiteThemeToggle client:load />
      </div>
      <p class="kit-note">
        Every component in the design system, in every variant its props allow.
        The theme toggle above is the only interactive island on this page —
        hover, press and focus states that live in component state stay idle
        here, so judge them in the running site. The focus ring comes from the
        stylesheet and does work: tab through the fields below.
      </p>
    </header>

    <section class="kit-section">
      <h2 class="label-mono">Core · Icon</h2>
      <div class="row">
        {uiGlyphs.map((name) => <Icon name={name} size={14} />)}
        {uiGlyphs.map((name) => <Icon name={name} size={18} />)}
        {uiGlyphs.map((name) => <Icon name={name} size={24} />)}
      </div>
      <p>
        Inline with text at 18px, baseline nudged: I ship systems <Icon
          name="terminal"
          size={18}
          strokeAlign
        />
        end to end.
      </p>
      <div class="row muted">
        {techMarks.map((name) => <Icon name={name} set="tech" size={18} />)}
      </div>
      <p class="kit-note">
        Tech marks render in muted ink or currentColor, never in a vendor
        colour.
      </p>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Core · Button</h2>
      {
        buttonVariants.map((variant) => (
          <div class="row">
            {buttonSizes.map((size) => (
              <Button variant={variant} size={size}>
                {variant} {size}
              </Button>
            ))}
            <Button variant={variant} disabled>
              Disabled
            </Button>
          </div>
        ))
      }
      <div class="row panel-accent">
        {
          buttonSizes.map((size) => (
            <Button variant="inverse" size={size}>
              Inverse {size}
            </Button>
          ))
        }
        <Button variant="inverse" disabled>Disabled</Button>
      </div>
      <p class="kit-note">
        Inverse sits on a gold or photographic panel — never on plain paper.
      </p>
      <div class="row">
        <Button icon="download" iconPosition="left" variant="secondary"
          >Resume, PDF</Button
        >
        <Button icon="arrow-up-right">See selected work</Button>
        <Button
          as="a"
          href="#core-button"
          variant="secondary"
          icon="mail"
          iconPosition="left"
        >
          Get in touch
        </Button>
      </div>
      <div class="field">
        <Button fullWidth>Full width</Button>
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Core · IconButton</h2>
      {
        iconButtonVariants.map((variant) => (
          <div class="row">
            {iconButtonSizes.map((size) => (
              <IconButton
                icon="arrow-up-right"
                label={`Open, ${variant} ${size}`}
                variant={variant}
                size={size}
              />
            ))}
          </div>
        ))
      }
      <div class="row">
        <IconButton
          as="a"
          href="https://github.com/nmhernandez10"
          icon="github"
          set="tech"
          label="GitHub"
        />
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Core · Tag</h2>
      <div class="row">
        {tagTones.map((tone) => <Tag tone={tone}>{tone}</Tag>)}
      </div>
      <div class="row">
        {
          tagTones.map((tone) => (
            <Tag tone={tone} size="sm">
              {tone}
            </Tag>
          ))
        }
      </div>
      <div class="row">
        <Tag tone="success" dot>Open to work</Tag>
        <Tag tone="neutral" dot>With dot</Tag>
        <Tag mono={false}>Prose tag, not mono</Tag>
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Core · Card</h2>
      <div class="grid">
        {
          cardTones.map((tone) => (
            <Card tone={tone}>
              <span class="label-mono">tone {tone}</span>
              <p>
                Structure comes from the hairline, so a card at rest carries no
                shadow.
              </p>
            </Card>
          ))
        }
      </div>
      <div class="grid">
        {
          cardPaddings.map((padding) => (
            <Card padding={padding}>
              <span class="label-mono">padding {padding}</span>
            </Card>
          ))
        }
      </div>
      <div class="grid">
        <Card as="a" href="#core-card" interactive>
          <span class="label-mono">interactive</span>
          <p>Lifts 2px on hover in the running site.</p>
        </Card>
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Core · Avatar</h2>
      <div class="row">
        <Avatar size="sm" />
        <Avatar size="md" />
        <Avatar size="lg" />
        <Avatar size="xl" />
        <Avatar size={72} />
      </div>
      <div class="row">
        <Avatar size="lg" shape="rounded" />
        <Avatar size="lg" ring />
      </div>
      <p class="kit-note">
        No portrait is wired yet, so every avatar shows its initials
        placeholder.
      </p>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Core · StatBlock</h2>
      <div class="row wide">
        <StatBlock size="sm" value="200k+" label="Sessions delivered" />
        <StatBlock size="md" value="85k+" label="Clients reached" />
        <StatBlock size="lg" value="6+" label="Years in production" />
        <StatBlock value="4–8" label="Engineers led" align="center" />
        <StatBlock
          value="200+"
          label="Restaurants"
          note="50–200 partner stores a month."
        />
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Forms · Input</h2>
      <div class="row wide">
        <Input label="Name" name="kit-name" placeholder="Nicolás Hernández" />
        <Input
          label="Email"
          name="kit-email"
          type="email"
          hint="I reply within a couple of days."
        />
        <Input
          label="Email"
          name="kit-email-error"
          type="email"
          error="Enter an email I can reply to."
        />
        <Input
          label="Disabled"
          name="kit-disabled"
          placeholder="Not editable"
          disabled
        />
        <Input
          label="With affixes"
          name="kit-affix"
          prefix="https://"
          suffix=".dev"
          placeholder="nicolasmateo"
        />
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Forms · Textarea</h2>
      <div class="row wide">
        <Textarea
          label="Message"
          name="kit-message"
          placeholder="A sentence or two is plenty."
        />
        <Textarea
          label="Message"
          name="kit-message-hint"
          hint="5 rows by default."
        />
        <Textarea
          label="Message"
          name="kit-message-error"
          error="Tell me what you are building."
        />
        <Textarea
          label="Disabled"
          name="kit-message-disabled"
          rows={3}
          disabled
        />
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Forms · Select</h2>
      <div class="row wide">
        <Select
          label="Reason"
          name="kit-reason"
          options={["A role", "Contract work", "Something else"]}
        />
        <Select
          label="Lens"
          name="kit-lens"
          options={[
            { value: "be", label: "Backend" },
            { value: "fs", label: "Full stack" },
          ]}
          hint="Objects carry a separate value and label."
        />
        <Select
          label="Disabled"
          name="kit-select-disabled"
          options={["Unavailable"]}
          disabled
        />
      </div>
      <p class="kit-note">
        Select has no error state in the kit — validation lives on Input and
        Textarea.
      </p>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Forms · Switch</h2>
      <div class="stack">
        <Switch label="Off" />
        <Switch label="On" checked />
        <Switch
          label="With description"
          description="The page never uses this one; it is here for completeness."
        />
        <Switch label="Disabled" disabled />
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Navigation · TextLink</h2>
      <div class="row">
        <TextLink href="#navigation-textlink">Default link</TextLink>
        <TextLink href="https://github.com/nmhernandez10" external
          >GitHub</TextLink
        >
        <TextLink href="#navigation-textlink" tone="muted">Muted tone</TextLink>
        <TextLink href="mailto:nm.hernandez1996@gmail.com"
          >nm.hernandez1996@gmail.com</TextLink
        >
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Navigation · SegmentedToggle</h2>
      <div class="row">
        <SegmentedToggle
          value="be"
          options={[
            { value: "be", label: "Backend" },
            { value: "fs", label: "Full stack" },
          ]}
        />
        <SegmentedToggle
          size="sm"
          value="fs"
          options={[
            { value: "be", label: "Backend" },
            { value: "fs", label: "Full stack" },
          ]}
        />
      </div>
      <p class="kit-note">
        Selected state is passed as a prop here. The page itself has no
        segmented control — this one is kit inventory.
      </p>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Navigation · ThemeToggle</h2>
      <p class="kit-note">
        The live one is in the page header — it writes data-theme on the root
        element.
      </p>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Content · SectionHeader</h2>
      <SectionHeader
        eyebrow="01 / Selected work"
        title="Systems I own end to end"
        lede="No screenshots here on purpose — each card states the system and the part I owned."
      />
      <SectionHeader
        eyebrow="02 / Centred"
        title="Centred alignment"
        lede="Same header, centre aligned."
        align="center"
      />
      <SectionHeader
        eyebrow="03 / No rule"
        title="Without the top hairline"
        rule={false}
      />
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Content · ProjectBrief</h2>
      <div class="grid">
        <ProjectBrief
          index="01"
          title="Keel Mind"
          role="Feature Architect"
          period="2022 — now"
          summary="A regulated mental-health platform: session domain modeling, API surface for web and mobile, and the reporting queries behind it."
          metrics={["200k+ sessions", "85k+ clients"]}
          stack={["NestJS", "PostgreSQL", "AWS", "React", "Flutter"]}
        />
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Content · ProjectCard</h2>
      <div class="grid">
        <ProjectCard
          title="Event pipeline and notifications"
          role="Design and delivery"
          period="2023 — 2025"
          summary="Recording, transcription and post-session analysis moved off the request path with Lambda, SQS and S3 — plus the notification fan-out that rides on it."
          metrics={["Async by default", "Retry and idempotency"]}
          stack={["AWS Lambda", "SQS", "S3", "Elasticsearch"]}
        />
      </div>
      <p class="kit-note">
        Without a real screenshot the media band says so, in mono.
      </p>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Content · WorkRow</h2>
      <div>
        <WorkRow
          index="01"
          title="Agent tooling for the team"
          role="Internal platform"
          period="2024 — now"
          summary="Internal tooling over agent CLIs: an agent-driven first pass on pull requests, versioned convention files, reusable skills and machine-executable specs."
          metrics={["Automated PR first pass", "Token budgets tuned"]}
          stack={["Claude Code", "Codex CLI", "Bedrock"]}
        />
        <WorkRow
          index="02"
          title="Compras Compartidas"
          role="Senior Software Developer"
          period="2020 — 2022"
          summary="The public REST API used by 50 to 200 partner stores a month — data contracts, PostgreSQL model, and the operational tooling around it."
          metrics={["50–200 partner stores"]}
          stack={["Node.js", "Python", "PostgreSQL"]}
        />
      </div>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Content · TimelineItem</h2>
      <ol class="timeline">
        <TimelineItem
          current
          role="Feature Architect"
          company="Keel Mind, Canada (remote)"
          period="March 2024 — present"
          location="Remote"
          bullets={[
            "Lead technical design and delivery across backend, web, mobile and QA teams of four to eight engineers.",
            "Own PostgreSQL modeling for core domains: schema design, migrations, indexing and query tuning.",
          ]}
        />
        <TimelineItem
          role="Senior Software Engineer"
          company="Keel Mind, Canada (remote)"
          period="June 2022 — March 2024"
          location="Remote"
          bullets={[
            "Designed REST and GraphQL APIs for web and mobile clients across first responder, Indigenous, academic and education care programs.",
          ]}
        />
        <TimelineItem
          last
          role="Full Stack Developer"
          company="Meniu"
          period="June 2019 — October 2020"
          location="Bogotá"
          bullets={[
            "Shipped the platform used daily by 200+ restaurants, where partners ran 10% to 40% of their daily sales through the product.",
          ]}
        />
      </ol>
      <p class="kit-note">
        Exactly one item is current; the last item drops the rail.
      </p>
    </section>

    <section class="kit-section">
      <h2 class="label-mono">Content · SkillGroup</h2>
      <div class="grid">
        <SkillGroup
          title="Data"
          icon="postgresql"
          items={["PostgreSQL", "Redis", "Elasticsearch"]}
        />
        <SkillGroup
          title="Practices"
          items={["Code review", "Technical design", "Mentoring"]}
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .kit {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-12) var(--gutter-lg) var(--space-20);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .kit-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .kit-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .kit-note {
    max-width: var(--measure-prose);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .kit-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .row.wide {
    align-items: flex-start;
    gap: var(--space-6);
  }

  /* Fields keep a readable width instead of stretching across the row. */
  .row.wide > * {
    flex: 0 1 300px;
  }

  .row.muted {
    color: var(--text-muted);
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .panel-accent {
    background: var(--accent);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }

  .field {
    max-width: 340px;
  }

  .timeline {
    margin: 0;
    padding: 0;
  }
</style>
