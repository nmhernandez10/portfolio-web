---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/content";
import { SiteNav } from "@/sections/SiteNav";
import Hero from "@/sections/Hero.astro";
import Work from "@/sections/Work.astro";
import Experience from "@/sections/Experience.astro";
import About from "@/sections/About.astro";
import Contact from "@/sections/Contact.astro";
import Footer from "@/sections/Footer.astro";

const title = `${profile.name} — ${profile.role}`;

// brand and resumeHref are passed rather than imported by the island: profile.ts
// carries the whole résumé, and only import-free content leaves may cross into a
// hydrated bundle. See src/content/index.ts.
---

<BaseLayout title={title} description={profile.lead}>
  <SiteNav
    slot="header"
    client:load
    brand={profile.name}
    resumeHref={profile.resumes.fullStack}
  />
  <Hero />
  <Work />
  <Experience />
  <About />
  <Contact />
  <Footer slot="footer" />
</BaseLayout>
