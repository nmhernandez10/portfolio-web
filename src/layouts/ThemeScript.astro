---
// The pre-paint theme resolution, owned in one file so every layout resolves
// the theme identically and no page can drift on the localStorage contract.
// is:inline is emitted verbatim, so the rendered markup is identical to the
// copies this replaced.
//
// The localStorage key is repeated in SiteThemeToggle because an is:inline
// script cannot import.
---

<script is:inline>
  // Resolves the theme before first paint; SiteThemeToggle adopts it after.
  (() => {
    let stored = null;
    try {
      stored = localStorage.getItem("theme");
    } catch {
      // Site data blocked — fall through to the system preference.
    }
    document.documentElement.dataset.theme =
      stored === "light" || stored === "dark"
        ? stored
        : window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
  })();
</script>
