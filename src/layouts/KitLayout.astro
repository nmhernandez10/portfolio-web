---
// Temporary: /kit runs on the new design system while / is still on the old
// one, and the two token sets collide on dozens of :root names with different
// values, so they can never load on the same page. VC3 deletes this file and
// returns /kit to BaseLayout once BaseLayout is on the new system too.
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/jetbrains-mono";
import "@/styles/redesign/index.css";
import ThemeScript from "./ThemeScript.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- The new --paper, converted to sRGB: light oklch(0.985 0.004 85) and
         dark oklch(0.205 0.008 70). Keyed to system preference rather than
         data-theme, as BaseLayout is; phase 7 settles that for both. -->
    <meta
      name="theme-color"
      content="#fbfaf7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a1713"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- Same contract as BaseLayout: the skip link and its target live in one
         file so a page cannot ship without a main landmark. -->
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" tabindex="-1"><slot /></main>
  </body>
</html>

<style>
  /* The new system's global.css does not exist yet, so the two rules this
     shell needs live here. VC3 folds them back into global.css. */
  .skip-link {
    position: absolute;
    top: var(--space-3);
    left: var(--gutter);
    z-index: 30;
    transform: translateY(-200%);
    padding: 10px 16px;
    background: var(--surface-card);
    border: 1px solid var(--border-control);
    border-radius: var(--radius-pill);
    font: var(--type-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-1);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .skip-link:focus {
    transform: none;
  }

  /* The skip link's target is the whole page, so a ring around it says less
     than the link that sent you there already did. */
  main[tabindex="-1"]:focus-visible {
    outline: none;
    box-shadow: none;
  }
</style>
