---
import { ProjectBrief } from "@/ui";
import { profile, twoDigit } from "@/content";
import Section from "./Section.astro";
---

<Section id="work">
  <div class="work-grid">
    {
      profile.work.map((item, i) => (
        <ProjectBrief
          index={twoDigit(i + 1)}
          title={item.title}
          role={item.role}
          period={item.period}
          summary={item.summary}
          metrics={item.metrics}
          stack={item.stack}
        />
      ))
    }
  </div>
</Section>
