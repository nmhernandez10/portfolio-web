---
import { Divider, SkillGroup } from "@/ui";
import { COPY, profile } from "@/content";
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
---

<Section id="about">
  <div class="about__grid">
    <div>
      <SectionIntro id="about" compact />
      <div class="about__prose">
        {COPY.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <Divider label={COPY.about.educationLabel} space="var(--space-7)" />
      <div class="about__education">
        {
          profile.education.map((entry) => (
            <div class="about__degree">
              <span class="about__degree-name">{entry.degree}</span>
              <span class="about__degree-meta">
                {entry.school} · {entry.period}
              </span>
            </div>
          ))
        }
      </div>
    </div>
    <div>
      {
        /* The same label-rail fold as ExperienceItem, through the same shared
           pair — SkillGroup's own grid is inline (SkillGroup.tsx) and carries
           its own defaults, hence the different fallbacks. */
        profile.skills.map((group) => (
          <SkillGroup
            {...group}
            style={{
              gridTemplateColumns: "var(--rail-cols, minmax(130px, 170px) 1fr)",
              gap: "var(--rail-gap, var(--space-5))",
            }}
          />
        ))
      }
    </div>
  </div>
</Section>
