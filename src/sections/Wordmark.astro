---
import { getImage } from "astro:assets";
import { Avatar } from "@/ui";
import { profile } from "@/content";
import portrait from "@/assets/portrait.jpg";

interface Props {
  /** Header wordmark is 18px, footer 20px. */
  size?: 18 | 20;
  /** Empty in the footer, where the header already names the person. */
  alt?: string;
}

const { size = 18, alt = profile.name } = Astro.props;

// The avatar renders at 36px; 72px is its 2x source. A centre crop of the
// portrait lands on the face.
const avatar = await getImage({
  src: portrait,
  width: 72,
  height: 72,
  fit: "cover",
});
---

<span class:list={["wordmark", size === 20 && "wordmark--lg"]}>
  <Avatar src={avatar.src} alt={alt} size="sm" />
  <span class="wordmark__name"
    >{profile.name}<span class="wordmark__dot">.</span></span
  >
</span>
