---
import { Button } from "@/ui";
import { profile } from "@/content";
import Wordmark from "./Wordmark.astro";
import SiteNav from "./SiteNav.astro";
import { SiteThemeToggle } from "./SiteThemeToggle";
---

<header class="site-header">
  <div class="site-header__inner">
    <Wordmark />
    <SiteNav />
    <div class="site-header__actions">
      <SiteThemeToggle client:load />
      {
        /* The kit writes `display` inline and takes no class, so hiding the
          button below 960px needs a section-owned element to bind to. */
      }
      <div class="site-header__resume">
        <Button
          as="a"
          href={profile.resumes.fullStack}
          size="sm"
          variant="secondary"
          icon="download"
          iconPosition="left">Resume</Button
        >
      </div>
    </div>
  </div>
</header>
