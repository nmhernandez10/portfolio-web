{
  // functions/ is its own TypeScript project: workerd's globals and the DOM lib
  // the site needs cannot share a program. These options mirror
  // astro/tsconfigs/strict — only lib and types differ, so nothing here is held
  // to a weaker standard than src/. The root tsconfig excludes this directory;
  // `pnpm check` runs it as `tsc -p functions`.
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // No DOM: on workerd, Request/Response/fetch come from the runtime types.
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"]
  }
}
