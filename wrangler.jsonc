{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-web",
  // Pages, not Workers: this key is what makes the file the source of truth for
  // the project, locking the dashboard's copies of these fields. `wrangler
  // pages dev` reads it too, so the preview script needs no directory argument.
  "pages_build_output_dir": "./dist",
  // Matches the installed workerd (1.20260815.1); bump alongside wrangler upgrades.
  "compatibility_date": "2026-08-15",
  // No environment config lives here. The contact endpoint's three keys —
  // EMAIL_FROM, EMAIL_TO and RESEND_API_KEY — are set per environment in the
  // dashboard (Settings → Variables and Secrets): the two addresses as plain
  // variables, the API key as a Secret. Locally all three sit in the gitignored
  // .dev.vars, which `wrangler pages dev` reads. Naming a var in this file would
  // lock the dashboard's copy of it, which is exactly why they moved out
  // (2026-08-23) — see AGENTS.md for the EMAIL_TO / profile.email rule.
}
