{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // functions/ is a separate project: workerd globals conflict with the DOM
  // lib the site needs. `pnpm check` runs it as `tsc -p functions`.
  "exclude": ["dist", "functions"],
  "compilerOptions": {
    // no baseUrl: TS 6 deprecates it (TS5101); paths already resolve relative to this file
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
